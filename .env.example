# =============================================================================
# FlagForge AI Agent System — Environment Configuration
# Copy to .env and fill in values. Never commit .env to version control.
# =============================================================================

# --- LLM Provider (orchestrator + coding agent) ---
# Supported: openai | anthropic | gemini | none (framework-only mode)
AGENT_LLM_PROVIDER=none
AGENT_LLM_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Agent Paths ---
AGENT_PROJECT_ROOT=.
AGENT_MEMORY_DIR=memory/data
AGENT_SKILLS_DIR=skills

# --- Orchestrator ---
ORCHESTRATOR_MAX_SUBTASKS=10
ORCHESTRATOR_PLANNING_ENABLED=true
ORCHESTRATOR_AUTO_EXECUTE=false

# --- Coding Agent ---
CODING_AGENT_ALLOWED_COMMANDS=npm,node,npx,tsc,tsx,git,prisma
CODING_AGENT_MAX_FILE_SIZE_KB=512
CODING_AGENT_DRY_RUN=false

# --- Slack Integration (optional) ---
SLACK_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ORCHESTRATOR=#agent-orchestrator
SLACK_CHANNEL_CODING=#agent-coding
SLACK_CHANNEL_LOGS=#agent-logs
SLACK_CHANNEL_HUMAN_REVIEW=#agent-human-review

# --- Autonomous Workflows ---
AUTONOMOUS_ENABLED=false
AUTONOMOUS_DAILY_INSPECTION_CRON=0 9 * * *
AUTONOMOUS_TIMEZONE=UTC

# --- Logging ---
AGENT_LOG_LEVEL=info
